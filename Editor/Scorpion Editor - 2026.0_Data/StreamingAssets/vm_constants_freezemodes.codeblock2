Constant FreezeMode_Off=0 //Actor returns to normal functionality
Constant FreezeMode_NoMovement=1 //Only movement is halted, animation and collision continue
Constant FreezeMode_OnlyTimer=2 //Everything except timer halted
Constant FreezeMode_Total=4 //Everything including timer halted
Constant FreezeMode_Recycle=8 //Recycle this actor per actor settings
